Subject: [PATCH] Validate async chunk packets before sending them


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 19b91dc3572e877434faa5a4a03a41b4c60085ad..1e73383644710d8372ba0f55189c44ee1710d326 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -438,22 +438,20 @@ public final class RegionizedPlayerChunkLoader {
         }
 
         // Leaf start - async chunk sender
-        private boolean leaf$sendChunk(final int chunkX, final int chunkZ) {
+        private void leaf$sendChunk(final int chunkX, final int chunkZ) {
             long k = CoordinateUtils.getChunkKey(chunkX, chunkZ);
-            if (!this.sentChunks.contains(k)) {
-                final LevelChunk chunk = ((ChunkSystemLevel) this.world).moonrise$getFullChunkIfLoaded(chunkX, chunkZ);
-                if (this.world.chunkPacketBlockController.shouldModify(this.player, chunk)) {
-                    this.sendChunk(chunkX, chunkZ);
-                    return true;
-                }
-                if (this.asyncSender.add(k)) {
-                    this.asyncSender.submit(net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket.prepareAsync(chunk, this.world.getLightEngine()));
-                    return true;
-                } else {
-                    return false;
-                }
+            if (this.sentChunks.contains(k)) {
+                throw new IllegalStateException();
             }
-            throw new IllegalStateException();
+            if (this.asyncSender.contains(k)) {
+                return;
+            }
+            final LevelChunk chunk = ((ChunkSystemLevel) this.world).moonrise$getFullChunkIfLoaded(chunkX, chunkZ);
+            if (this.world.chunkPacketBlockController.shouldModify(this.player, chunk)) {
+                this.sendChunk(chunkX, chunkZ);
+                return;
+            }
+            this.asyncSender.submit(k, chunk.moonrise$getChunkHolder().vanillaChunkHolder.clientVisibleChanges, net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket.prepareAsync(chunk, this.world.getLightEngine()));
         }
         private void leaf$sendChunkRaw(final net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket chunkPacket) {
             final int chunkX = chunkPacket.getX();
@@ -899,17 +897,14 @@ public final class RegionizedPlayerChunkLoader {
                         return;
                     } // else: good to dequeue and send, fall through
                 }
-                //this.sendQueue.dequeueLong(); // Leaf - async chunk sender
-
                 // Leaf start - async chunk sender
+                if (this.asyncSender != null && !this.asyncSender.canSubmit()) {
+                    break;
+                }
+                this.sendQueue.dequeueLong();
                 if (this.asyncSender != null) {
-                    if (this.leaf$sendChunk(pendingSendX, pendingSendZ)) {
-                        this.sendQueue.dequeueLong();
-                    } else {
-                        break;
-                    }
+                    this.leaf$sendChunk(pendingSendX, pendingSendZ);
                 } else {
-                    this.sendQueue.dequeueLong();
                     this.sendChunk(pendingSendX, pendingSendZ);
                 }
                 // Leaf end - async chunk sender
@@ -921,11 +916,24 @@ public final class RegionizedPlayerChunkLoader {
             }
             // Leaf start - async chunk sender
             if (this.asyncSender != null) {
-                net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket packet;
-                while ((packet = this.asyncSender.recv()) != null) {
-                    if (this.asyncSender.remove(CoordinateUtils.getChunkKey(packet.getX(), packet.getZ()))) {
+                org.dreeam.leaf.async.chunk.AsyncChunkSender.Result result;
+                while ((result = this.asyncSender.recv()) != null) {
+                    if (!this.asyncSender.complete(result)) {
+                        continue;
+                    }
+                    final int chunkX = CoordinateUtils.getChunkX(result.chunkKey());
+                    final int chunkZ = CoordinateUtils.getChunkZ(result.chunkKey());
+                    final net.minecraft.server.level.ChunkHolder chunkHolder = ((ChunkSystemServerLevel)this.world).moonrise$getChunkTaskScheduler().chunkHolderManager
+                        .getChunkHolder(chunkX, chunkZ).vanillaChunkHolder;
+                    final net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket packet = result.packet();
+                    if (packet == null || chunkHolder.clientVisibleChanges != result.changeCount()) {
+                        this.sendChunk(chunkX, chunkZ);
+                    } else {
                         this.leaf$sendChunkRaw(packet);
                     }
+                    if (this.removed) {
+                        return;
+                    }
                 }
             }
             // Leaf end - async chunk sender
