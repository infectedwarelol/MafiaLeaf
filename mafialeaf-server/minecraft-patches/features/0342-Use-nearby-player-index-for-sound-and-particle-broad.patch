         for (int i1 = 0; i1 < receivers.size(); i1++) { // Paper - particle API
             ServerPlayer serverPlayer = receivers.get(i1); // Paper - particle API
+            if (!this.isWithinParticleRange(serverPlayer, overrideLimiter, x, y, z)) continue;
             if (sender != null && !serverPlayer.getBukkitEntity().canSee(sender.getBukkitEntity())) continue; // CraftBukkit // Leaf - Remove stream in CraftWorld#spawnParticle - diff on change
             if (this.sendParticles(serverPlayer, overrideLimiter, x, y, z, clientboundLevelParticlesPacket)) {
                 i++;
@@ -2493,17 +2494,23 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     }
 
     private boolean sendParticles(ServerPlayer player, boolean overrideLimiter, double x, double y, double z, Packet<?> packet) {
+        if (!this.isWithinParticleRange(player, overrideLimiter, x, y, z)) {
+            return false;
+        }
+        player.connection.send(packet);
+        return true;
+    }
+
+    private boolean isWithinParticleRange(ServerPlayer player, boolean overrideLimiter, double x, double y, double z) {
         if (player.level() != this) {
             return false;
-        } else {
-            BlockPos blockPos = player.blockPosition();
-            if (blockPos.closerToCenterThan(new Vec3(x, y, z), overrideLimiter ? 512.0 : 32.0)) {
-                player.connection.send(packet);
-                return true;
-            } else {
-                return false;
-            }
         }
+        final BlockPos blockPos = player.blockPosition();
+        final double range = overrideLimiter ? 512.0 : 32.0;
+        final double dx = blockPos.getX() + 0.5 - x;
+        final double dy = blockPos.getY() + 0.5 - y;
+        final double dz = blockPos.getZ() + 0.5 - z;
+        return dx * dx + dy * dy + dz * dz < range * range;
     }
 
