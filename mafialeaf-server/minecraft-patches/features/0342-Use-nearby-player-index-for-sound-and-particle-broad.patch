+    private static final double INDEXED_BROADCAST_RADIUS_LIMIT = 128.0;
+
     public void broadcast(@Nullable Player except, double x, double y, double z, double radius, ResourceKey<Level> dimension, Packet<?> packet) {
-        for (int i = 0; i < this.players.size(); i++) {
-            ServerPlayer serverPlayer = this.players.get(i);
-            // CraftBukkit start - Test if player receiving packet can see the source of the packet
-            if (except != null && !serverPlayer.getBukkitEntity().canSee(except.getBukkitEntity())) {
-               continue;
-            }
-            // CraftBukkit end
-            if (serverPlayer != except && serverPlayer.level().dimension() == dimension) {
-                double d = x - serverPlayer.getX();
-                double d1 = y - serverPlayer.getY();
-                double d2 = z - serverPlayer.getZ();
-                if (d * d + d1 * d1 + d2 * d2 < radius * radius) {
-                    serverPlayer.connection.send(packet);
+        final double radiusSquared = radius * radius;
+        if (radius <= INDEXED_BROADCAST_RADIUS_LIMIT && ca.spottedleaf.moonrise.common.util.TickThread.isTickThread()) {
+            final ServerLevel level = this.server.getLevel(dimension);
+            if (level != null) {
+                final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> nearby = level.moonrise$getNearbyPlayers().getPlayersByBlock(
+                    net.minecraft.util.Mth.floor(x), net.minecraft.util.Mth.floor(z), ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.GENERAL_SMALL
+                );
+                if (nearby == null) {
+                    return;
                 }
+                final ServerPlayer[] raw = nearby.getRawDataUnchecked();
+                for (int i = 0, size = nearby.size(); i < size; i++) {
+                    this.broadcastTo(raw[i], except, x, y, z, radiusSquared, dimension, packet);
+                }
+                return;
             }
         }
+        for (int i = 0; i < this.players.size(); i++) {
+            this.broadcastTo(this.players.get(i), except, x, y, z, radiusSquared, dimension, packet);
+        }
+    }
+
+    private void broadcastTo(ServerPlayer serverPlayer, @Nullable Player except, double x, double y, double z, double radiusSquared, ResourceKey<Level> dimension, Packet<?> packet) {
+        if (serverPlayer == except || serverPlayer.level().dimension() != dimension) {
+            return;
+        }
+        double d = x - serverPlayer.getX();
+        double d1 = y - serverPlayer.getY();
+        double d2 = z - serverPlayer.getZ();
+        if (d * d + d1 * d1 + d2 * d2 >= radiusSquared) {
+            return;
+        }
+        if (except != null && !serverPlayer.getBukkitEntity().canSee(except.getBukkitEntity())) {
+            return;
+        }
+        serverPlayer.connection.send(packet);
     }
 
