+    private int indexOfIdentity(final Ticket ticket) {
+        final int index = binarySearch(this.tickets, 0, this.size, ticket);
+        if (index >= 0 && this.tickets[index] == ticket) {
+            return index;
+        }
+        for (int i = 0; i < this.size; ++i) {
+            if (this.tickets[i] == ticket) {
+                return i;
             }
         }
-
-        // cleanup end
-        Arrays.fill(tickets, lastIndex, len, null);
-        this.size = lastIndex;
-        return removed;
+        throw new IllegalStateException("Timed ticket " + ticket + " is not present in its ticket set");
     }
 
