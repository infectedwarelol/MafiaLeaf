@@ -13,16 +13,42 @@ import java.util.function.Predicate;
 
 public final class TicketSet extends AbstractSet<Ticket> {
 
+    private static final Ticket[] EMPTY_TICKETS = new Ticket[0];
+
     private Ticket[] tickets;
     private int size;
+    private Ticket[] timedTickets = EMPTY_TICKETS;
+    private int timedSize;
 
     public TicketSet(final int initialCapacity) {
         this.tickets = new Ticket[initialCapacity];
     }
 
-    private TicketSet(final Ticket[] tickets, final int size) {
+    private TicketSet(final Ticket[] tickets, final int size, final Ticket[] timedTickets, final int timedSize) {
         this.tickets = tickets;
         this.size = size;
+        this.timedTickets = timedTickets;
+        this.timedSize = timedSize;
+    }
+
+    private void trackTimed(final Ticket ticket) {
+        if (!ChunkHolderManager.hasRemoveDelay(ticket)) {
+            return;
+        }
+        if (this.timedSize == this.timedTickets.length) {
+            this.timedTickets = Arrays.copyOf(this.timedTickets, Math.max(4, this.timedSize << 1));
+        }
+        this.timedTickets[this.timedSize++] = ticket;
+    }
+
+    private void untrackTimed(final Ticket ticket) {
+        for (int i = 0; i < this.timedSize; ++i) {
+            if (this.timedTickets[i] == ticket) {
+                this.timedTickets[i] = this.timedTickets[--this.timedSize];
+                this.timedTickets[this.timedSize] = null;
+                return;
+            }
+        }
     }
 
     // returns ~<insertion index> when not found, which is always < 0
@@ -83,9 +109,11 @@ public final class TicketSet extends AbstractSet<Ticket> {
 
         ++this.size;
         this.tickets[index] = ticket;
+        this.trackTimed(ticket);
     }
 
     private void removeAt(final int index) {
+        this.untrackTimed(this.tickets[index]);
         if (index != --this.size) {
             System.arraycopy(this.tickets, index + 1, this.tickets, index, this.size - index);
         }
@@ -95,7 +123,7 @@ public final class TicketSet extends AbstractSet<Ticket> {
 
     public TicketSet copy() {
         final int size = this.size;
-        return new TicketSet(Arrays.copyOf(this.tickets, size), size);
+        return new TicketSet(Arrays.copyOf(this.tickets, size), size, Arrays.copyOf(this.timedTickets, this.timedTickets.length), this.timedSize);
     }
 
     public Ticket[] copyBackingArray() {
@@ -106,7 +134,9 @@ public final class TicketSet extends AbstractSet<Ticket> {
         final int index = binarySearch(this.tickets, 0, this.size, object);
         if (index >= 0) {
             final Ticket old = this.tickets[index];
+            this.untrackTimed(old);
             this.tickets[index] = object;
+            this.trackTimed(object);
             return old;
         }
 
@@ -174,40 +204,36 @@ public final class TicketSet extends AbstractSet<Ticket> {
         Objects.checkFromIndexSize(0, this.size, array.length);
 
         int removed = 0;
