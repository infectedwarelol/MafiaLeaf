@@ -35,7 +35,8 @@ public record ServerBuildInfoImpl(
     // Leaf start - Rebrand
     private static final String BRAND_PUFFERFISH_NAME = "Pufferfish";
     private static final String BRAND_PURPUR_NAME = "Purpur";
-    private static final String BRAND_LEAF_NAME = "Leaf";
+    private static final String BRAND_MAFIALEAF_NAME = "MafiaLeaf";
+    private static final Key BRAND_MAFIALEAF_ID = Key.key("infectedwarelol", "mafialeaf");
     // Leaf end - Rebrand
 
